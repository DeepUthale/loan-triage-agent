# Copy to .env. Without this file the app runs the offline demo engine.
LOAN_TRIAGE_LLM_MODE=anthropic
ANTHROPIC_API_KEY=

# Optional overrides
# LOAN_TRIAGE_MODEL=claude-sonnet-5-5
# LOAN_TRIAGE_EXTRACTION_EFFORT=medium
# LOAN_TRIAGE_DATA_DIR=data

# Email intake uses a synthetic demo inbox until you switch it on.
# See "Email intake" in the README first.
# LOAN_TRIAGE_MAILBOX_MODE=gmail
# LOAN_TRIAGE_GMAIL_QUERY=label:loan-applications has:attachment filename:pdf newer_than:30d
